{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "angular/dist/angular",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{nestjs/dist/**,nestjs/generated/**,nestjs/prisma/schema.prisma}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
